# Gatehouse settings. On a server, ops/install.sh writes .env from this file with random passwords; on a laptop,
# `make setup` does. Never commit or send .env: it holds the database passwords and the backup key.
COMPOSE_PROJECT_NAME=gatehouse

# production on a server, development on a laptop. In production the demo data and the end-to-end tests refuse to run.
INSTANCE=development

# On a server: https (turns on the HTTPS front door on ports 80 and 443). Empty on a laptop.
COMPOSE_PROFILES=

# The address people type, without https://, e.g. gatehouse.example.com, or the server's name or IP on site.
DOMAIN=localhost

# How the HTTPS certificate is made:
#   you@example.com                    free certificate from Let's Encrypt, renewed by itself (needs DOMAIN to be a
#                                      public DNS name pointing at this server, and ports 80 and 443 open to the internet)
#   internal                           the front door's own certificate, for an on-site network without a public name
#                                      (each device must trust it once; see README.md)
#   "/certs/cert.pem /certs/key.pem"   your own certificate files, placed in deploy/certs/
TLS=internal

# Database. POSTGRES_* is the setup account (migrations only); the app connects as gatehouse_app.
POSTGRES_USER=gatehouse
POSTGRES_DB=gatehouse
POSTGRES_PASSWORD=
APP_DB_PASSWORD=

# The app's own ports, on 127.0.0.1 only (never reachable from the network)
WEB_PORT=3600
API_PORT=3601
DB_PORT=5438
# The front door's ports (servers)
HTTP_PORT=80
HTTPS_PORT=443

# How long a staff sign-in lasts, in hours (1-24)
SESSION_HOURS=12

# true when the site is served over HTTPS (cookies are then only sent over HTTPS). Always true on a server.
COOKIE_SECURE=false

# The app listens on 127.0.0.1 only, so people always reach it through the HTTPS front door, which passes on each
# visitor's real address. true = the sign-in lockout uses that address, so one stranger's wrong passwords only lock out
# that stranger. Leave true.
BEHIND_PROXY=true

# Encrypts every backup (make backup). Keep a copy away from this server: without it no backup can be read.
BACKUP_KEY=
